# ===========================================================================
# .env.example — TRACKED template. Copy to .env (UNTRACKED, in .gitignore).
# Alternative to config.php for hosts that inject environment variables
# (cPanel, Docker, Cloudflare Tunnel). Either source works; config.php
# takes precedence if both exist. Never put real secrets in this file.
# ===========================================================================

# Database (replaces hardcoded root/'' in 9 files)
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=cyclone_db

# App / CORS (replaces hardcoded /Weather + Access-Control-Allow-Origin: *)
# APP_DOMAIN is the real production domain (CNAME is currently invalid:
# "tropical_cyclone_weatherapp.com" — underscores don't resolve in DNS).
APP_BASE_URL=/Weather
APP_DOMAIN=

# SMTP (replaces hardcoded Gmail user + app-password in forgot-password.php)
# The old app-password is compromised — revoke it, put the fresh one in .env only.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Tropical Cyclone Info System

# Import script (replaces hardcoded R2 URL + local Windows path)
R2_PUBLIC_BASE=https://pub-d18dd40b0f164c4eab0bcc9308b66340.r2.dev
LOCAL_DATA_PATH=
